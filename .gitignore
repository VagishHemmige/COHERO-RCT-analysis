# R, RStudio and Positron
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.httr-oauth
.DS_Store
Rplots.pdf

# Quarto. The site is rendered and published by the GitHub Actions workflow
# (.github/workflows/publish.yml), so the rendered docs/ is not committed.
/.quarto/
**/*.quarto_ipynb
/docs/

# Credentials and local settings (COHERO_DATA_DIR lives in .Renviron)
.Renviron
.env
*.pem
*.key

# The original RMD and anything knitted from it stay private
MR_SJ_asthma_pilot*

# Data files. Study data live outside the repository, in the folder named by
# COHERO_DATA_DIR; this is a safety net, not access control.
/data-raw/
*.csv
*.xlsx
*.xls
*.rds
*.rda
*.sas7bdat
*.sas7bcat
*.xpt
*.dta
*.sav
*.parquet
*.feather
*.arrow
*.fst

# Outputs, ignored until the review named in AGENTS.md clears them for
# public release. Removing these lines does not track tables saved as .csv
# or .rds: the data-format patterns above still hide those, so cleared
# tables need their own exceptions.
/figures/
/tables/
# Animations made from study data (gganimate)
*.gif

# Approved public files: add narrow exceptions here, never a whole format.
# !tests/fixtures/synthetic.csv
